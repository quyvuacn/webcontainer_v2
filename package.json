{
  "name": "browser-node",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "proxy": "node proxy-server/index.ts",
    "build": "vite build",
    "build:prod": "node scripts/build.js",
    "build:obfuscate": "node scripts/build.js --obfuscate",
    "check-env": "bash scripts/check-env.sh",
    "build:placeholder": "bash build/build-placeholder.sh",
    "build:vfs": "node scripts/build-vfs.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "vitest run js/benchmark.test.ts --reporter=verbose"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/semver": "^7.7.1",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "es-module-lexer": "^2.0.0",
    "esbuild-wasm": "^0.27.4",
    "eventemitter3": "^5.0.4",
    "fflate": "^0.8.2",
    "readable-stream": "^4.7.0",
    "semver": "^7.7.4",
    "string_decoder": "^1.3.0",
    "util": "^0.12.5"
  }
}
